{
  "name": "modisa",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "modisa": "src/main.ts"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile src/main.ts --outfile dist/modisa && (command -v codesign >/dev/null && codesign --remove-signature dist/modisa && codesign -s - dist/modisa || true)"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@iconify-json/solar": "^1.2.10",
    "@types/bun": "latest",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "libghostty-vt": "^0.6.3",
    "re2js": "2.8.6",
    "zod": "^4.6.1"
  }
}
